# .gitattributes
# Tells Git how to handle line endings and file types.
# Prevents cross-platform issues (e.g., the ^M error on Linux/Mac).
# Docs: https://git-scm.com/docs/gitattributes

# --- Default: auto-detect text vs binary ---
* text=auto


# --- Shell scripts: MUST be LF (Unix line endings) ---
# CRLF in .sh files causes: /bin/bash^M: bad interpreter
*.sh text eol=lf


# --- Windows scripts: CRLF (Windows convention) ---
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf


# --- Documentation & config: LF (Unix convention, safest) ---
*.md   text eol=lf
*.txt  text eol=lf
*.json text eol=lf
*.xml  text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf


# --- Java source and related files: LF ---
*.java       text eol=lf
*.kt         text eol=lf
*.gradle     text eol=lf
*.properties text eol=lf


# --- Extension-less files: force text + LF ---
LICENSE   text eol=lf
README    text eol=lf
CHANGELOG text eol=lf
NOTICE    text eol=lf


# --- Binary files: Git must not touch them ---
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.icns binary
*.jar  binary
*.exe  binary
*.dll  binary
*.zip  binary